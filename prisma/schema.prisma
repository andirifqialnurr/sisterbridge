generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  ADMIN
  OPERATOR
  REVIEWER
  VIEWER

  @@map("app_role")
}

enum SisterOperationStatus {
  PENDING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW

  @@map("sister_operation_status")
}

enum SisterSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED

  @@map("sister_sync_status")
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("security_severity")
}

enum SecurityOutcome {
  SUCCESS
  DENIED
  FAILED
  BLOCKED
  DETECTED

  @@map("security_outcome")
}

model AppUser {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique @db.VarChar(320)
  name            String               @db.VarChar(160)
  role            AppRole              @default(VIEWER)
  isActive        Boolean              @default(true) @map("is_active")
  // Required by better-auth; users are created by an admin, never self-signup.
  emailVerified   Boolean              @default(false) @map("email_verified")
  image           String?              @db.VarChar(2048)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  authSessions    AuthSession[]
  authAccounts    AuthAccount[]
  operations      SisterOperation[]    @relation("sister_operation_actor")
  securityEvents  SecurityAuditEvent[] @relation("security_audit_actor")
  securityReviews SecurityAuditEvent[] @relation("security_audit_reviewer")

  @@map("app_user")
}

// better-auth tables (src/server/auth/auth.ts). The session token is an
// opaque random value; credential passwords are hashed by better-auth.
model AuthSession {
  id        String   @id @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.VarChar(1024)
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verification")
}

model SisterIntegration {
  id                String                   @id @default(uuid()) @db.Uuid
  externalPtId      String?                  @map("external_pt_id") @db.VarChar(128)
  baseUrl           String                   @map("base_url") @db.VarChar(2048)
  apiVersion        String                   @default("1.0.0") @map("api_version") @db.VarChar(32)
  credentialRef     String                   @map("credential_ref") @db.VarChar(255)
  expectedRole      String?                  @map("expected_role") @db.VarChar(32)
  isEnabled         Boolean                  @default(false) @map("is_enabled")
  lastHealthAt      DateTime?                @map("last_health_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  referenceCaches   SisterReferenceCache[]  
  sdmIndexCaches    SisterSdmIndexCache[]
  operations        SisterOperation[]
  securityEvents    SecurityAuditEvent[]
  syncRuns          SisterSyncRun[]
  replicaRecords    SisterReplicaRecord[]
  replicaScopes     SisterReplicaScope[]

  @@index([isEnabled])
  @@map("sister_integration")
}

model SisterReferenceCache {
  id            String            @id @default(uuid()) @db.Uuid
  integrationId String            @map("integration_id") @db.Uuid
  endpoint      String            @db.VarChar(255)
  queryHash     String            @map("query_hash") @db.VarChar(128)
  payloadJson   Json              @map("payload_json")
  fetchedAt     DateTime          @default(now()) @map("fetched_at")
  expiresAt     DateTime          @map("expires_at")
  lastError     String?           @map("last_error") @db.Text
  integration   SisterIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, endpoint, queryHash])
  @@index([expiresAt])
  @@map("sister_reference_cache")
}

model SisterSdmIndexCache {
  integrationId      String            @map("integration_id") @db.Uuid
  idSdm              String            @map("id_sdm") @db.VarChar(128)
  namaSdm            String            @map("nama_sdm") @db.VarChar(255)
  nidn               String?           @db.VarChar(64)
  nip                String?           @db.VarChar(64)
  nuptk              String?           @db.VarChar(64)
  namaStatusAktif    String?           @map("nama_status_aktif") @db.VarChar(128)
  namaStatusPegawai  String?           @map("nama_status_pegawai") @db.VarChar(128)
  jenisSdm           String?           @map("jenis_sdm") @db.VarChar(128)
  fetchedAt          DateTime          @default(now()) @map("fetched_at")
  integration        SisterIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, idSdm])
  @@index([integrationId, namaSdm])
  @@index([integrationId, nidn])
  @@index([integrationId, nip])
  @@map("sister_sdm_index_cache")
}

// One execution of the read-only replica sync (`bun run sister:sync`).
// stats_json holds per-endpoint counters and redacted error codes only, never
// payloads, tokens, or credentials.
model SisterSyncRun {
  id            String            @id @default(uuid()) @db.Uuid
  integrationId String            @map("integration_id") @db.Uuid
  baseUrl       String            @map("base_url") @db.VarChar(2048)
  scope         String            @db.VarChar(64)
  status        SisterSyncStatus  @default(RUNNING)
  requestCount  Int               @default(0) @map("request_count")
  recordCount   Int               @default(0) @map("record_count")
  changedCount  Int               @default(0) @map("changed_count")
  deletedCount  Int               @default(0) @map("deleted_count")
  errorCount    Int               @default(0) @map("error_count")
  statsJson     Json?             @map("stats_json")
  startedAt     DateTime          @default(now()) @map("started_at")
  finishedAt    DateTime?         @map("finished_at")
  // Refreshed with the counters every 30s while RUNNING; a stale heartbeat
  // means the process died and the run may be marked FAILED.
  heartbeatAt   DateTime?         @map("heartbeat_at")
  integration   SisterIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@index([status])
  @@map("sister_sync_run")
}

// Local read-only copy of SISTER GET responses. One row per list item or per
// object response, keyed by endpoint template + request scope + item key.
// Rows missing from a later complete fetch of the same scope get deleted_at
// instead of being removed, so history stays auditable.
model SisterReplicaRecord {
  integrationId String            @map("integration_id") @db.Uuid
  endpoint      String            @db.VarChar(255)
  scopeKey      String            @map("scope_key") @db.VarChar(512)
  itemKey       String            @map("item_key") @db.VarChar(255)
  idSdm         String?           @map("id_sdm") @db.VarChar(64)
  parentId      String?           @map("parent_id") @db.VarChar(128)
  payloadJson   Json              @map("payload_json")
  payloadHash   String            @map("payload_hash") @db.VarChar(64)
  firstSeenAt   DateTime          @default(now()) @map("first_seen_at")
  changedAt     DateTime          @default(now()) @map("changed_at")
  fetchedAt     DateTime          @default(now()) @map("fetched_at")
  deletedAt     DateTime?         @map("deleted_at")
  lastSyncRunId String?           @map("last_sync_run_id") @db.Uuid
  integration   SisterIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, endpoint, scopeKey, itemKey])
  @@index([integrationId, idSdm, endpoint])
  @@index([integrationId, endpoint, deletedAt])
  @@map("sister_replica_record")
}

// Fetch state per endpoint scope (for example `/penelitian` + `id_sdm=...`).
// Lets the sync skip child requests whose parent row did not change and shows
// which scopes SISTER failed to answer.
model SisterReplicaScope {
  integrationId String            @map("integration_id") @db.Uuid
  endpoint      String            @db.VarChar(255)
  scopeKey      String            @map("scope_key") @db.VarChar(512)
  idSdm         String?           @map("id_sdm") @db.VarChar(64)
  itemCount     Int               @default(0) @map("item_count")
  lastStatus    Int               @map("last_status")
  lastErrorCode String?           @map("last_error_code") @db.VarChar(64)
  lastFetchedAt DateTime          @default(now()) @map("last_fetched_at")
  lastSuccessAt DateTime?         @map("last_success_at")
  lastSyncRunId String?           @map("last_sync_run_id") @db.Uuid
  integration   SisterIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, endpoint, scopeKey])
  @@index([integrationId, lastStatus])
  @@map("sister_replica_scope")
}

model SisterOperation {
  id                  String                @id @default(uuid()) @db.Uuid
  integrationId       String                @map("integration_id") @db.Uuid
  actorUserId         String?               @map("actor_user_id") @db.Uuid
  method              String                @db.VarChar(8)
  pathTemplate        String                @map("path_template") @db.VarChar(512)
  resourceType        String                @map("resource_type") @db.VarChar(128)
  resourceId          String?               @map("resource_id") @db.VarChar(128)
  requestFingerprint  String                @map("request_fingerprint") @db.VarChar(128)
  requestRedactedJson Json?                 @map("request_redacted_json")
  responseStatus      Int?                  @map("response_status")
  externalId         String?               @map("external_id") @db.VarChar(128)
  localStatus         SisterOperationStatus @default(PENDING) @map("local_status")
  externalMessage     String?               @map("external_message") @db.Text
  externalDetail      String?               @map("external_detail") @db.Text
  startedAt           DateTime              @default(now()) @map("started_at")
  finishedAt          DateTime?             @map("finished_at")
  integration         SisterIntegration     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  actorUser           AppUser?              @relation("sister_operation_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([integrationId, startedAt])
  @@index([integrationId, localStatus])
  @@index([actorUserId, startedAt])
  @@map("sister_operation")
}

model SecurityAuditEvent {
  id                  String            @id @default(uuid()) @db.Uuid
  eventType           String            @map("event_type") @db.VarChar(128)
  severity            SecuritySeverity
  outcome             SecurityOutcome
  actorUserId         String?           @map("actor_user_id") @db.Uuid
  integrationId       String?           @map("integration_id") @db.Uuid
  requestId           String            @map("request_id") @db.VarChar(128)
  routeOrProcedure    String            @map("route_or_procedure") @db.VarChar(512)
  targetType          String?           @map("target_type") @db.VarChar(128)
  targetId            String?           @map("target_id") @db.VarChar(128)
  sourceIpHash        String?           @map("source_ip_hash") @db.VarChar(128)
  userAgentHash       String?           @map("user_agent_hash") @db.VarChar(128)
  metadataRedactedJson Json?            @map("metadata_redacted_json")
  createdAt           DateTime          @default(now()) @map("created_at")
  reviewedAt          DateTime?         @map("reviewed_at")
  reviewedBy          String?           @map("reviewed_by") @db.Uuid
  actorUser           AppUser?          @relation("security_audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)
  integration         SisterIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  reviewer            AppUser?          @relation("security_audit_reviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([severity, outcome, createdAt])
  @@index([actorUserId, createdAt])
  @@index([integrationId, createdAt])
  @@map("security_audit_event")
}
