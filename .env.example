# Local PostgreSQL database. Never commit a real credential.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sister_integrated"

# Docker Compose PostgreSQL (the web container uses DATABASE_URL_DOCKER).
POSTGRES_DB="sister_integrated"
POSTGRES_USER="sister_app"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
DATABASE_URL_DOCKER="postgresql://sister_app:replace-with-a-long-random-password@postgres:5432/sister_integrated?schema=public"
WEB_HOST_PORT="3100"

# SISTER Web Service PT. Production (NODE_ENV=production, e.g. the Docker
# image) always uses SISTER_BASE_URL. Anywhere else the sandbox in
# SISTER_BASE_URL_DEV is used when it is set.
SISTER_BASE_URL="https://sister-api.kemdiktisaintek.go.id/ws.php/1.0/"
SISTER_BASE_URL_DEV="https://sister-api.kemdiktisaintek.go.id/ws-sandbox.php/1.0/"
SISTER_ID_PENGGUNA="<id_pengguna>"
# Any UUID you generate once; replica rows and caches are keyed by it.
SISTER_INTEGRATION_ID="<local-integration-uuid>"
SISTER_USERNAME="<sister_ws_username>"
SISTER_PASSWORD="<sister_ws_password>"
SISTER_CREDENTIAL_REF="environment"
SISTER_SDM_CACHE_TTL_SECONDS="300"

# Application session secret (also signs better-auth sessions). At least 32
# random bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET="<generate-a-long-random-secret>"
APP_URL="http://localhost:2700"
APP_ALLOWED_ORIGINS="http://localhost:2700"
TRUST_PROXY="false"
TRPC_MAX_BODY_BYTES="32768"
TRPC_MAX_URL_BYTES="16384"
TRPC_RATE_LIMIT_MAX="120"
TRPC_RATE_LIMIT_WINDOW_MS="60000"

# true = synthetic data and an automatic fixture user (development only).
# false = live SISTER data and real login (create users with
# `bun run auth:create-user`). Production always behaves as false.
SISTER_FIXTURE_MODE="true"
